{
  "name": "expo-auth-session",
  "version": "58.0.14",
  "description": "Expo module for browser-based authentication",
  "keywords": [
    "auth",
    "auth-session",
    "authentication",
    "expo",
    "expo-auth-session",
    "oauth",
    "react-native"
  ],
  "homepage": "https://docs.expo.dev/versions/latest/sdk/auth-session",
  "bugs": {
    "url": "https://github.com/expo/expo/issues"
  },
  "license": "MIT",
  "author": "650 Industries, Inc.",
  "repository": {
    "type": "git",
    "url": "https://github.com/expo/expo.git",
    "directory": "packages/expo-auth-session"
  },
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "expo-source": "./src/index.ts",
        "default": "./build/index.d.ts"
      },
      "expo-source": "./src/index.ts",
      "default": "./build/index.js"
    },
    "./providers/facebook": {
      "types": {
        "expo-source": "./src/providers/Facebook.ts",
        "default": "./build/providers/Facebook.d.ts"
      },
      "expo-source": "./src/providers/Facebook.ts",
      "default": "./build/providers/Facebook.js"
    },
    "./providers/facebook.js": {
      "types": {
        "expo-source": "./src/providers/Facebook.ts",
        "default": "./build/providers/Facebook.d.ts"
      },
      "expo-source": "./src/providers/Facebook.ts",
      "default": "./build/providers/Facebook.js"
    },
    "./providers/google": {
      "types": {
        "expo-source": "./src/providers/Google.ts",
        "default": "./build/providers/Google.d.ts"
      },
      "expo-source": "./src/providers/Google.ts",
      "default": "./build/providers/Google.js"
    },
    "./providers/google.js": {
      "types": {
        "expo-source": "./src/providers/Google.ts",
        "default": "./build/providers/Google.d.ts"
      },
      "expo-source": "./src/providers/Google.ts",
      "default": "./build/providers/Google.js"
    },
    "./build/PKCE": {
      "types": {
        "expo-source": "./src/PKCE.ts",
        "default": "./build/PKCE.d.ts"
      },
      "expo-source": "./src/PKCE.ts",
      "default": "./build/PKCE.js"
    },
    "./build/PKCE.js": {
      "types": {
        "expo-source": "./src/PKCE.ts",
        "default": "./build/PKCE.d.ts"
      },
      "expo-source": "./src/PKCE.ts",
      "default": "./build/PKCE.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "expo-application": "~58.1.2",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-linking": "~58.0.14",
    "expo-web-browser": "~58.0.6",
    "invariant": "^2.2.4"
  },
  "devDependencies": {
    "@expo/internal-scripts": "58.0.4",
    "@types/invariant": "^2.2.33",
    "@types/react": "~19.3.0"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "jest": {
    "preset": "@expo/internal-scripts"
  },
  "scripts": {
    "build": "expo-build src",
    "clean": "expo-module clean",
    "lint": "oxlint --config oxlint.config.mjs .",
    "format": "expo-module format",
    "test": "jest",
    "depscheck": "expo-module depscheck",
    "typecheck": "tsc -p tsconfig.json"
  }
}